# PB Exchange Environment Configuration

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pb_exchange
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pb_exchange

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Session Secrets
JWT_SECRET=pb_exchange_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=1d
COOKIE_SECRET=pb_exchange_cookie_session_secret_2026

# Admin Seed
SUPER_ADMIN_USERNAME=developer
SUPER_ADMIN_PASSWORD=Admin@12345

# Login security: 3 wrong logins in a row block the IP (Access Block page).
# 0 = blocked until an admin deletes it there; e.g. 30 = auto-unblock after 30 minutes.
LOGIN_BLOCK_MINUTES=0
